# If your backend is deployed on Render, set these to your Render service URL
# Example:
# VITE_API_URL=https://your-backend-service.onrender.com/api
# VITE_SOCKET_URL=https://your-backend-service.onrender.com
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000

# --- Real-mode phone verification (MSG91 OTP Widget) ---
# Optional: leave unset and "Real" mode will show a friendly "not configured
# yet" message while "Demo" mode keeps working normally. Powers real SMS OTP
# on: staff/patient login, Book an appointment, and the Emergency request page.
# From your MSG91 dashboard: OTP Widget > your widget > Client side
# integration. widgetId is the widget's ID; tokenAuth is the widget-specific
# token shown there (NOT your account authkey - that stays server-side only,
# see backend/.env.example).
VITE_MSG91_WIDGET_ID=
VITE_MSG91_TOKEN_AUTH=

# --- Online consultation video calls (WebRTC) ---
# By default, calls use free public STUN servers plus a shared free TURN
# relay (Open Relay Project) as a fallback for networks where STUN alone
# can't connect (mobile data, corporate/restrictive firewalls, CGNAT) - so
# calls should work out of the box. That shared relay is rate-limited and
# not meant for real patient-facing volume, though. For production, get
# your own TURN server (self-hosted coturn, or a hosted provider like
# Metered, Twilio Network Traversal, or Xirsys) and set these to override
# the default:
VITE_TURN_URLS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
