PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/heartstone

# JWT / sessions
JWT_SECRET=your_jwt_secret_key_change_in_production
# Short-lived access token (sent on every API call). Default 15m.
ACCESS_TOKEN_EXPIRE=15m
# How long the httpOnly refresh-token cookie ("remember me" duration) lasts,
# in days. The refresh token itself is stored server-side as a hash and is
# individually revocable (see /api/auth/sessions) - this is just its max
# lifetime absent revocation.
REFRESH_TOKEN_EXPIRE_DAYS=30
# Refresh-token cookie attributes. Same-site deployments (frontend+backend on
# the same registrable domain, or reverse-proxied together) should leave this
# as "lax" (or use "strict"). If the frontend and backend are on DIFFERENT
# sites (e.g. frontend on Vercel, backend on Render) you MUST set this to
# "none" - browsers will otherwise silently drop the cookie - and you must
# also set COOKIE_SECURE=true (requires HTTPS).
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false

# CORS
FRONTEND_URL=http://localhost:5173

# Demo OTP (frontend only)
DEMO_OTP=1234

# --- Gemini AI chatbot ---
# Get a Gemini API key from Google AI Studio and keep it ONLY on the backend.
# The browser never receives this key.
GEMINI_API_KEY=
# Stable model used by the public hospital chatbot. Override if needed.
GEMINI_MODEL=gemini-3.6-flash

# --- Real-mode phone verification (MSG91 OTP Widget) ---
# Optional: leave unset and "Real" mode will show a friendly "not configured
# yet" error while "Demo" mode keeps working normally. Verifies MSG91 access
# tokens for: staff/patient login, Book an appointment, and the Emergency
# request page. From the MSG91 dashboard: top-right username dropdown > Authkey.
# This is the SAME authkey used to verify the widget's access-token
# server-side (see server_side_auth reference) - do not confuse it with the
# widget's tokenAuth, which is a frontend-only value.
MSG91_AUTHKEY=

# --- Transactional email via Brevo ---
# Used for: staff forgot-password OTP emails, and the password-protected
# prescription PDF emailed to a patient whenever a bill is generated for
# their appointment (see utils/mailer.js#sendPrescriptionPdfEmail).
# Optional: leave unset and forgot-password will return a friendly "not
# configured yet" error, while the prescription-PDF email is silently
# skipped (logged to console) rather than blocking bill generation.
# Sign up free at brevo.com, verify a single sender email (Senders, Domains
# & Dedicated IPs > Senders > Add a Sender - just click the confirmation
# link Brevo emails to that address, no DNS/domain needed), then create an
# API key under SMTP & API > API Keys.
BREVO_API_KEY=
EMAIL_FROM=HeartStone Hospital <heartstone.noreply@gmail.com>
# Optional: replies to the OTP email will land here instead of nowhere.
EMAIL_REPLY_TO=heartstone.noreply@gmail.com

# --- Auto-cancel past appointments ---
# Optional: any appointment still "booked" once this many minutes have
# passed since its slot time gets automatically cancelled. Defaults to 30.
APPOINTMENT_AUTO_CANCEL_GRACE_MINUTES=30
